#!/usr/bin/env bash
# proxmox-os-installer: cloud-image VM creation on Proxmox VE 8+ (amd64)
set -Eeuo pipefail
umask 077

VERSION="0.2.2"
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd -P)"
CATALOG="${ROOT}/catalog/os-images.tsv"
CHECKER="${ROOT}/lib/image_catalog.py"
PREFLIGHT="${ROOT}/lib/preflight.py"
CACHE_OPS="${ROOT}/lib/cache_ops.py"
SSH_ACCESS="${ROOT}/lib/ssh_access.py"
CACHE="${PROXMOX_OS_INSTALLER_CACHE:-/var/cache/proxmox-os-installer/images}"
LIB="${ROOT}/lib"

# shellcheck source=lib/common.sh
source "$LIB/common.sh"

VMID=""
CREATED=0
TMP_IMG=""
TMP_SUM=""
TMP_SSH=""
TMP_USER_DUMP=""
SSH_INLINE_VALIDATED=0
DRY_RUN=0
STAGE_NUM=0
STAGE_LABEL=""

cleanup() {
  local status=$?
  [[ -n "$TMP_IMG" ]] && rm -f -- "$TMP_IMG"
  [[ -n "$TMP_SUM" ]] && rm -f -- "$TMP_SUM"
  [[ -n "$TMP_SSH" ]] && rm -f -- "$TMP_SSH"
  [[ -n "$TMP_USER_DUMP" ]] && rm -f -- "$TMP_USER_DUMP"
  if (( status != 0 && CREATED == 1 )); then
    printf '\nWARNING: VM %s may be partially configured. It was NOT automatically deleted.\n' "$VMID" >&2
    printf 'Inspect with: qm config %s\n' "$VMID" >&2
  fi
}
trap cleanup EXIT

ask() {
  local title="$1" default="$2" response=""
  if [[ -n "$default" ]]; then
    read -r -p "$title [$default]: " response || error 'Input cancelled.'
  else
    read -r -p "$title: " response || error 'Input cancelled.'
  fi
  printf '%s' "${response:-$default}"
}
ask_yes() {
  local answer
  answer="$(ask "$1 (y/n)" "$2")"
  case "${answer,,}" in y|yes) return 0 ;; n|no) return 1 ;; *) error 'Answer y or n.' ;; esac
}
int_range() {
  local val="$1" label="$2" min="$3" max="$4"
  [[ "$val" =~ ^[0-9]{1,9}$ ]] || error "$label must be a number."
  (( 10#$val >= min && 10#$val <= max )) || error "$label must be $min-$max."
}

case "${1:-}" in
  --version) printf '%s\n' "$VERSION"; exit 0 ;;
  --list-os)
    python3 "$CHECKER" catalog-check "$CATALOG" >/dev/null || exit 1
    awk -F '|' '!/^#/ && NF == 7 { printf "%-17s %s\n", $1, $2 }' "$CATALOG"
    exit 0 ;;
  --check-catalog) exec python3 "$CHECKER" catalog-check "$CATALOG" ;;
  --check-upstream) exec python3 "$CHECKER" check-upstream "$CATALOG" ;;
  --cache-list) exec python3 "$CACHE_OPS" list "$CACHE" "$CATALOG" ;;
  --cache-prune)
    if [[ "${2:-}" == "--yes" ]]; then
      exec python3 "$CACHE_OPS" prune "$CACHE" "$CATALOG" --yes
    fi
    python3 "$CACHE_OPS" prune "$CACHE" "$CATALOG"
    printf '\nDelete the files listed above? (y/n) [n]: '
    read -r ans || exit 1
    case "${ans,,}" in y|yes) exec python3 "$CACHE_OPS" prune "$CACHE" "$CATALOG" --yes ;; *) printf 'Cancelled.\n'; exit 0 ;; esac
    ;;
  --dry-run) DRY_RUN=1 ;;
  '') ;;
  *) error 'Usage: proxmox-os-installer [--version|--list-os|--check-catalog|--check-upstream|--cache-list|--cache-prune|--dry-run]' ;;
esac

(( EUID == 0 )) || error 'Run as root on a Proxmox VE node.'
for prog in qm pvesm pvesh python3 curl qemu-img sha256sum sha512sum flock ip awk; do
  command -v "$prog" >/dev/null 2>&1 || error "Missing required command: $prog"
done
[[ "$(uname -m)" == "x86_64" ]] || error 'This release only supports x86_64 Proxmox nodes.'
python3 "$CHECKER" catalog-check "$CATALOG" >/dev/null || error 'OS catalog is invalid.'

# shellcheck source=lib/interactive.sh
source "$LIB/interactive.sh"

DRY_SUFFIX=""
if [[ "$DRY_RUN" == 1 ]]; then DRY_SUFFIX=' (DRY RUN)'; fi
printf 'Proxmox OS Installer v%s%s\n\n' "$VERSION" "$DRY_SUFFIX"
select_os_entry

NEXT_ID="$(pvesh get /cluster/nextid --output-format json 2>/dev/null | tr -d '"[:space:]' || true)"
[[ "$NEXT_ID" =~ ^[0-9]+$ ]] || NEXT_ID=130
VMID="$(ask 'VM ID' "$NEXT_ID")"
int_range "$VMID" 'VM ID' 100 999999999
assert_vmid_free
VM_NAME="$(ask 'VM name' "${OS_ID}-${VMID}")"
[[ "$VM_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}$ ]] || error 'Invalid VM name.'
CORES="$(ask 'CPU cores' 8)"
RAM_GIB="$(ask 'RAM (GiB)' 24)"
DISK_GIB="$(ask 'Disk (GiB)' 150)"
int_range "$CORES" 'CPU cores' 1 256
int_range "$RAM_GIB" 'RAM' 1 1024
int_range "$DISK_GIB" 'Disk' 10 16384
RAM_MIB="$((10#$RAM_GIB*1024))"

stage 'Preflight validation'
assert_vmid_free
pick_storage
pick_bridge
VLAN="$(ask 'VLAN tag (blank = untagged)' '')"
NIC="virtio,bridge=$BRIDGE"
if [[ -n "$VLAN" ]]; then
  int_range "$VLAN" 'VLAN' 1 4094
  NIC+=",tag=$VLAN"
fi
MODE="$(ask 'IPv4 configuration (dhcp/static)' dhcp)"
DNS=""
case "${MODE,,}" in
  dhcp) IP_CONFIG="ip=dhcp" ;;
  static)
    IP_CIDR="$(ask 'IPv4/CIDR (example 192.0.2.10/24)' '')"
    GW="$(ask 'IPv4 gateway' '')"
    DNS="$(ask 'DNS server IPv4 (blank = Proxmox default)' '')"
    python3 - "$IP_CIDR" "$GW" "$DNS" <<'PY' || error 'Invalid IP/CIDR/gateway/DNS.'
import ipaddress,sys
try:
    addr=ipaddress.IPv4Interface(sys.argv[1])
    gw=ipaddress.IPv4Address(sys.argv[2])
    if addr.ip.is_multicast or addr.ip.is_unspecified or gw.is_multicast or gw.is_unspecified:
        raise ValueError('unspecified/multicast')
    if sys.argv[3]: ipaddress.IPv4Address(sys.argv[3])
except ValueError: sys.exit(1)
PY
    IP_CONFIG="ip=$IP_CIDR,gw=$GW"
    ;;
  *) error 'Network mode must be dhcp or static.' ;;
esac

collect_auth
print_summary

if [[ "$DRY_RUN" == 1 ]]; then
  printf 'DRY RUN: no downloads, file writes, or VM changes performed.\n'
  exit 0
fi
ask_yes 'Create this VM' n || { printf 'Cancelled.\n'; exit 0; }

# Resolve snippet storage before any VM mutation; create the file only after
# Proxmox has generated its full per-VM user-data.
if (( SSH_PASSWORD_LOGIN == 1 )); then
  SNIPPET_FILE="pveosi-${VMID}-user.yaml"
  SNIPPET_VOLID="${SNIPPET_STORAGE}:snippets/${SNIPPET_FILE}"
  SNIPPET_PATH="$(pvesm path "$SNIPPET_VOLID")" || error 'Cannot resolve Proxmox snippets storage path.'
  if [[ "$SNIPPET_PATH" != /* || "${SNIPPET_PATH##*/}" != "$SNIPPET_FILE" ||
        "$(basename -- "$(dirname -- "$SNIPPET_PATH")")" != snippets ]]; then
    error 'Unexpected Proxmox snippet path; refusing to write outside snippets storage.'
  fi
  if [[ -e "$SNIPPET_PATH" || -L "$SNIPPET_PATH" ]]; then
    error 'Existing snippet name for this VM; refusing to overwrite.'
  fi
fi

install -d -m 0700 "$CACHE"
exec {LOCK_FD}>"$CACHE/${OS_ID}.lock"
flock -x "$LOCK_FD"

stage 'Upstream metadata and checksum verification'
TMP_SUM="$(mktemp "$CACHE/.checksums.XXXXXXXX")"
SUMS_URL="${BASE_URL}/${SUMS_FILE}"
IMAGE_URL="${BASE_URL}/${IMAGE_FILE}"
if ! curl --fail --location --silent --show-error --retry 3 --connect-timeout 20 \
  --proto '=https' --proto-redir '=https' -o "$TMP_SUM" "$SUMS_URL"; then
  provisioning_failed "fetch checksum manifest" "Unable to fetch $SUMS_URL"
fi
EXPECTED="$(python3 "$CHECKER" digest "$TMP_SUM" "$IMAGE_FILE" "$ALGO")" || provisioning_failed "parse checksum manifest"
CACHED_IMAGE="${CACHE}/${OS_ID}-${IMAGE_FILE}"
verify() { printf '%s  %s\n' "$EXPECTED" "$1" | "${ALGO}sum" -c --status -; }

stage 'Image download or cache reuse'
if [[ -s "$CACHED_IMAGE" ]] && verify "$CACHED_IMAGE"; then
  info 'Using checksum-verified image from local cache'
else
  TMP_IMG="$(mktemp "$CACHE/.image.XXXXXXXX")"
  info "Downloading official ${OS_LABEL} image"
  if ! curl --fail --location --show-error --retry 3 --connect-timeout 20 \
    --proto '=https' --proto-redir '=https' -o "$TMP_IMG" "$IMAGE_URL"; then
    provisioning_failed "download cloud image" "Failed to download $IMAGE_URL"
  fi
  verify "$TMP_IMG" || provisioning_failed "verify downloaded image checksum" "SHA mismatch; no VM created."
  chmod 0600 "$TMP_IMG"
  mv -f -- "$TMP_IMG" "$CACHED_IMAGE"
  TMP_IMG=""
fi

python3 "$PREFLIGHT" image-validate "$CACHED_IMAGE" "$DISK_GIB" >/dev/null || \
  provisioning_failed "image size/format validation"

assert_vmid_free

stage 'VM creation'
qm_run "create VM ${VMID}" create "$VMID" --name "$VM_NAME" --cores "$CORES" --cpu host \
  --memory "$RAM_MIB" --net0 "$NIC" --scsihw virtio-scsi-single \
  --serial0 socket --vga serial0 --agent enabled=1 --ostype l26
CREATED=1

stage 'Disk import and resize'
qm_run "import disk for VM ${VMID} onto ${STORAGE}" set "$VMID" \
  --scsi0 "${STORAGE}:0,import-from=${CACHED_IMAGE},discard=on,iothread=1,ssd=1"
qm_run "resize VM ${VMID} disk to ${DISK_GIB} GiB" resize "$VMID" scsi0 "${DISK_GIB}G"

stage 'Cloud-Init configuration'
qm_run "attach cloud-init drive for VM ${VMID}" set "$VMID" --ide2 "${STORAGE}:cloudinit"
qm_run "set boot order for VM ${VMID}" set "$VMID" --boot 'order=scsi0'
qm_run "set cloud-init user for VM ${VMID}" set "$VMID" --ciuser "$USERNAME"
qm_run "set cloud-init network for VM ${VMID}" set "$VMID" --ipconfig0 "$IP_CONFIG"
[[ -n "$DNS" ]] && qm_run "set DNS for VM ${VMID}" set "$VMID" --nameserver "$DNS"
[[ -n "$SSH_PUBKEY" ]] && qm_run "set SSH keys for VM ${VMID}" set "$VMID" --sshkeys "$SSH_PUBKEY"
if (( PASSWORD_SET == 1 )); then
  qm_set_cloud_init_password "$VMID"
  unset PASSWORD
fi
if (( SSH_PASSWORD_LOGIN == 1 )); then
  # qm cloudinit dump includes the Proxmox-generated user, keys and password.
  # Never print its output: it can contain password data.
  TMP_USER_DUMP="$(mktemp)"
  if ! qm cloudinit dump "$VMID" user >"$TMP_USER_DUMP" 2>/dev/null; then
    provisioning_failed 'generate Proxmox user-data for password SSH'
  fi
  install -d -m 0755 -- "$(dirname -- "$SNIPPET_PATH")"
  ACCESS_MODE=user
  if (( ROOT_PASSWORD_LOGIN == 1 )); then ACCESS_MODE=root; fi
  python3 "$SSH_ACCESS" create "$TMP_USER_DUMP" "$SNIPPET_PATH" "$ACCESS_MODE" ||
    provisioning_failed 'prepare first-boot SSH user-data snippet'
  qm_run "attach password SSH cloud-init snippet for VM ${VMID}" set "$VMID" --cicustom "user=${SNIPPET_VOLID}"
  printf 'First-boot SSH user-data: %s (keep this file for VM start/migration)\n' "$SNIPPET_VOLID"
fi

stage 'Final verification'
python3 "$PREFLIGHT" verify-vm "$VMID" >/dev/null || provisioning_failed "post-create verification"

stage 'Optional VM startup'
printf '\nSUCCESS: VM %s (%s) created.\n' "$VMID" "$OS_LABEL"
printf 'Resources: %s vCPU, %s GiB RAM, %s GiB disk on %s\n' "$CORES" "$RAM_GIB" "$DISK_GIB" "$STORAGE"
if ask_yes 'Start VM now' y; then
  qm_run "start VM ${VMID}" start "$VMID"
  printf 'VM started. Serial console: qm terminal %s\n' "$VMID"
else
  printf 'VM left stopped. Start: qm start %s\n' "$VMID"
fi
printf 'Inspect: qm config %s\n' "$VMID"
printf '%s\n' 'Reminder: QEMU Guest Agent must be installed in the guest; enabling the VM option alone does not guarantee it works.'
if (( SSH_PASSWORD_LOGIN == 1 )); then
  printf '%s\n' 'Password SSH is configured for first boot; verify inside the guest after cloud-init completes.'
else
  printf '%s\n' 'Reminder: cloud images may disable password-based SSH; SSH keys are preferred.'
fi
